{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Panel and detail window",
  "windows": ["panel", "detail"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
